DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
LOG_LEVEL=INFO

# Option 1: Local Ollama Model (e.g. huihui_ai/llama3.2-abliterate:3b-instruct)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=huihui_ai/llama3.2-abliterate:3b-instruct

# Option 2: OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
